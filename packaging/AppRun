#!/bin/sh
# Point d'entrée de l'AppImage notrefu-mirror.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="$HERE"
export PYTHONPATH="$HERE/usr/app"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1

# Bazzite/KDE Plasma tourne en Wayland : on le privilégie, avec repli sur X11.
if [ -z "$QT_QPA_PLATFORM" ] && [ -n "$WAYLAND_DISPLAY" ]; then
    export QT_QPA_PLATFORM="wayland;xcb"
fi

exec "$HERE/usr/python/bin/python3" -m notrefu_mirror "$@"
